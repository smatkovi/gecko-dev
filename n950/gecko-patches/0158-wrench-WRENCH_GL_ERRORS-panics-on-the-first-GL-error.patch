From 3d624ed8f3883c5e8a996f561a2da36a9279175e Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 14:34:04 +0100
Subject: [PATCH 158/160] wrench: WRENCH_GL_ERRORS panics on the first GL error

Sets WebRender's panic_on_gl_error, so a release build stops at the
first call an OpenGL ES 2.0 context rejects, with its name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/wr/wrench/src/wrench.rs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/gfx/wr/wrench/src/wrench.rs b/gfx/wr/wrench/src/wrench.rs
index a36d7a2d0485..e0fc3ea9aa7b 100644
--- a/gfx/wr/wrench/src/wrench.rs
+++ b/gfx/wr/wrench/src/wrench.rs
@@ -280,6 +280,7 @@ impl Wrench {
             clear_caches_with_quads: !window.is_software(),
             compositor_config,
             enable_debugger: true,
+            panic_on_gl_error: std::env::var_os("WRENCH_GL_ERRORS").is_some(),
             ..Default::default()
         };
 
