From 0de8cc5381fc012f061dfea00d352fdc13fb2150 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Sat, 14 Nov 2026 04:01:51 +0100
Subject: [PATCH] EmbedLite: WebRender draws into the embedder's native window
 when given one

An EmbedLite compositor widget was always offscreen: WebRender rendered
into a GL screen buffer whose front buffer the embedder took as an
EGLImage and drew again with its own GL (Qt Quick). When the embedder
names a native window (NS_NATIVE_WINDOW of the EmbedLite widget), the
widget is no longer offscreen and RenderCompositorEGL draws into an EGL
window surface for it, created with the compositor (IsPaused() holds the
renderer back until there is one) and again on Resume().

On the N950 (SGX530, X11) this gives about 28 % less CPU per frame and
more frames while scrolling.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../RenderCompositorEGL.cpp                   | 22 +++++++++++++++++++
 gfx/webrender_bindings/RenderCompositorEGL.h  |  1 +
 widget/EmbedLiteCompositorWidget.h            |  6 ++++-
 3 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/gfx/webrender_bindings/RenderCompositorEGL.cpp b/gfx/webrender_bindings/RenderCompositorEGL.cpp
index bdc5cab1758e..e68279385cfd 100644
--- a/gfx/webrender_bindings/RenderCompositorEGL.cpp
+++ b/gfx/webrender_bindings/RenderCompositorEGL.cpp
@@ -97,6 +97,12 @@ RenderCompositorEGL::RenderCompositorEGL(
       mUseEmbedLiteOffscreen(aUseEmbedLiteOffscreen) {
   MOZ_ASSERT(mGL);
   LOG("RenderCompositorEGL::RenderCompositorEGL()");
+#ifdef MOZ_EMBEDLITE
+  // IsPaused() holds the renderer back until there is a surface
+  if (!mUseEmbedLiteOffscreen && !CreateEmbedLiteWindowSurface()) {
+    gfxCriticalNote << "EL-direct: no EGL surface for the native window";
+  }
+#endif
 #ifdef MOZ_WAYLAND
   if (widget::GdkIsWaylandDisplay()) {
     mEGLSurface = CreateEGLSurface();
@@ -127,6 +133,17 @@ RenderCompositorEGL::~RenderCompositorEGL() {
 }
 
 #ifdef MOZ_EMBEDLITE
+bool RenderCompositorEGL::CreateEmbedLiteWindowSurface() {
+  mEGLSurface = CreateEGLSurface();
+  if (mEGLSurface == EGL_NO_SURFACE) {
+    return false;
+  }
+  const auto& gle = gl::GLContextEGL::Cast(gl());
+  MakeCurrent();
+  gle->mEgl->fSwapInterval(gfx::gfxVars::SwapIntervalEGL() ? 1 : 0);
+  return true;
+}
+
 bool RenderCompositorEGL::EnsureEmbedLiteOffscreenTarget() {
   MOZ_ASSERT(mUseEmbedLiteOffscreen);
   const auto size = GetBufferSize().ToUnknownSize();
@@ -167,6 +184,9 @@ bool RenderCompositorEGL::BeginFrame() {
     return false;
   }
   const bool hasOffscreenTarget = mUseEmbedLiteOffscreen;
+  if (!mUseEmbedLiteOffscreen && mEGLSurface == EGL_NO_SURFACE) {
+    CreateEmbedLiteWindowSurface();
+  }
 #else
   const bool hasOffscreenTarget = false;
 #endif
@@ -280,6 +300,8 @@ bool RenderCompositorEGL::Resume() {
     gfxCriticalNote << "EL-Resume ensure=" << elOk;
     return elOk;
   }
+  DestroyEGLSurface();
+  return CreateEmbedLiteWindowSurface();
 #endif
   if (kIsAndroid) {
     // Destroy EGLSurface if it exists.
diff --git a/gfx/webrender_bindings/RenderCompositorEGL.h b/gfx/webrender_bindings/RenderCompositorEGL.h
index 7fa1190422b0..62bfb048f600 100644
--- a/gfx/webrender_bindings/RenderCompositorEGL.h
+++ b/gfx/webrender_bindings/RenderCompositorEGL.h
@@ -54,6 +54,7 @@ class RenderCompositorEGL : public RenderCompositor {
 
 #ifdef MOZ_EMBEDLITE
   bool EnsureEmbedLiteOffscreenTarget();
+  bool CreateEmbedLiteWindowSurface();
 #endif
 
   RefPtr<gl::GLContext> mGL;
diff --git a/widget/EmbedLiteCompositorWidget.h b/widget/EmbedLiteCompositorWidget.h
index a6b07050918b..97208fe1f0ba 100644
--- a/widget/EmbedLiteCompositorWidget.h
+++ b/widget/EmbedLiteCompositorWidget.h
@@ -17,7 +17,11 @@ class EmbedLiteCompositorWidget final : public InProcessCompositorWidget {
       const layers::CompositorOptions& aOptions, nsIWidget* aWidget);
 
   EmbedLiteCompositorWidget* AsEmbedLite() override { return this; }
-  bool IsEmbedLiteOffscreen() const override { return true; }
+  // offscreen (platform image) unless the embedder gave a native window
+  bool IsEmbedLiteOffscreen() const override {
+    nsIWidget* widget = const_cast<EmbedLiteCompositorWidget*>(this)->RealWidget();
+    return !widget || !widget->GetNativeData(NS_NATIVE_WINDOW);
+  }
 };
 
 }  // namespace mozilla::widget
