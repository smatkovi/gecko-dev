From 02dee1b88586e1d49e4757bdeb7462a7d0be92e9 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Thu, 12 Nov 2026 18:10:13 +0100
Subject: [PATCH 197/197] webrender: BGRA8 glyphs on the PowerVR SGX, 256x256
 glyph pages on ES 2.0

With R8 glyph pages the SGX530 lost earlier glyphs once later ones were
uploaded next to them: while scrolling, text vanished except for the
glyphs rasterized in that frame. Its driver also rearranges R8 uploads
byte by byte: 100-200 ms per upload of a glyph. BGRA8 glyph pages keep
every glyph and take 1-3 ms per upload (WebRender's profiler on the
N950). The glyph pages are 256x256 on ES 2.0, as large in bytes as a
512x512 R8 page.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/webrender_bindings/src/bindings.rs | 3 ++-
 gfx/wr/webrender/src/device/gl.rs      | 7 +++++--
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/gfx/webrender_bindings/src/bindings.rs b/gfx/webrender_bindings/src/bindings.rs
index c57bc020d19d..47b67394ae59 100644
--- a/gfx/webrender_bindings/src/bindings.rs
+++ b/gfx/webrender_bindings/src/bindings.rs
@@ -2143,10 +2143,11 @@ pub extern "C" fn wr_window_new(
         TextureCacheConfig {
             color8_linear_texture_size: 512,
             color8_nearest_texture_size: 512,
-            color8_glyph_texture_size: 512,
+            color8_glyph_texture_size: if gles2 { 256 } else { 512 },
             alpha8_texture_size: 512,
             alpha8_glyph_texture_size: 512,
             alpha16_texture_size: 512,
+            compact_single_channel: !gles2,
         }
     };
 
diff --git a/gfx/wr/webrender/src/device/gl.rs b/gfx/wr/webrender/src/device/gl.rs
index afbd1cd7f13e..fcd448d78b8b 100644
--- a/gfx/wr/webrender/src/device/gl.rs
+++ b/gfx/wr/webrender/src/device/gl.rs
@@ -2099,8 +2099,11 @@ impl Device {
         // On Linux we we have seen uploads to R8 format textures result in
         // corruption on some AMD cards.
         // See https://bugzilla.mozilla.org/show_bug.cgi?id=1687554#c13
-        let supports_r8_texture_upload = if cfg!(target_os = "linux")
-            && renderer_name.starts_with("AMD Radeon RX")
+        // On the PowerVR SGX530 (OpenGL ES 2.0) glyphs in R8 textures went
+        // missing once later glyphs were uploaded next to them; BGRA8 keeps them.
+        let supports_r8_texture_upload = if (cfg!(target_os = "linux")
+            && renderer_name.starts_with("AMD Radeon RX"))
+            || renderer_name.starts_with("PowerVR SGX")
         {
             false
         } else {
