From e8a151e76f3ce2f3c5dc6e96c649935722b5074c Mon Sep 17 00:00:00 2001
From: fork <fork@local>
Date: Sat, 22 Aug 2026 21:23:12 +0000
Subject: [PATCH 134/156] Prompter: take the EmbedLite password result outside
 the promptvalue guard (the auth popup replies with password, not promptvalue)

---
 toolkit/components/prompts/src/Prompter.sys.mjs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/toolkit/components/prompts/src/Prompter.sys.mjs b/toolkit/components/prompts/src/Prompter.sys.mjs
index bf45909f0aa3..03cd8b643163 100644
--- a/toolkit/components/prompts/src/Prompter.sys.mjs
+++ b/toolkit/components/prompts/src/Prompter.sys.mjs
@@ -1182,6 +1182,7 @@ class ModalPrompter {
         }
         if ("promptvalue" in response) {
           args.value = response.promptvalue;
+        }
         if (args.promptType == "promptPassword") {
           args.pass = response.password || "";
           console.debug(
@@ -1189,7 +1190,6 @@ class ModalPrompter {
             " length=" + args.pass.length
           );
         }
-        }
 
         closed = true;
         cleanup();
-- 
2.56.0

