diff --git a/gfx/wr/webrender/res/base.glsl b/gfx/wr/webrender/res/base.glsl
index e381ff6ca9c9..f8d9f14f3512 100644
--- a/gfx/wr/webrender/res/base.glsl
+++ b/gfx/wr/webrender/res/base.glsl
@@ -61,6 +61,8 @@
     precision highp float;
     #if __VERSION__ != 100
         #define varying in
+    #else
+        precision highp int;
     #endif
 #endif
 
@@ -68,3 +70,89 @@
 #if __VERSION__ == 100
     #define flat
 #endif
+
+// GLSL ES 1.00: texelFetch on texel centres with the texture size from a
+// uniform (webrender_build rewrites the calls, see rewrite_for_gles2).
+#if __VERSION__ == 100
+    #define WR_TEXEL_FETCH(sampler, size, position, lod, offset) texture2D(sampler, (vec2((position) + (offset)) + 0.5) / (size))
+    #define WR_TEXEL_FETCH_I(sampler, size, position, lod, offset) ivec4(texture2D(sampler, (vec2((position) + (offset)) + 0.5) / (size)))
+    #define WR_TEXEL_FETCH1(sampler, size, position, lod) texture2D(sampler, (vec2(position) + 0.5) / (size))
+    #define WR_TEXEL_FETCH1_I(sampler, size, position, lod) ivec4(texture2D(sampler, (vec2(position) + 0.5) / (size)))
+#endif
+
+// Integer bit operations. ESSL 1 has no bitwise operators and no %;
+// there they are computed with floats, exact for magnitudes below 2^24.
+#if __VERSION__ == 100
+    float wr_pow2(int n) {
+        return exp2(float(n));
+    }
+
+    int wr_bits(int x, int shift, int count) {
+        float v = floor(float(x) / wr_pow2(shift));
+        float m = wr_pow2(count);
+        return int(v - floor(v / m) * m);
+    }
+
+    bool wr_has_flag(int x, int flag) {
+        float v = floor(float(x) / float(flag));
+        return v - 2.0 * floor(v / 2.0) > 0.5;
+    }
+
+    int wr_mod(int a, int b) {
+        return int(float(a) - floor(float(a) / float(b)) * float(b));
+    }
+
+    #define WR_BITS(x, shift, count) wr_bits(x, shift, count)
+    #define WR_HAS_FLAG(x, flag) wr_has_flag(x, flag)
+    #define WR_SHL(x, n) ((x) * int(wr_pow2(n)))
+    #define WR_SHR(x, n) int(floor(float(x) / wr_pow2(n)))
+    #define WR_MOD(a, b) wr_mod(a, b)
+#else
+    #define WR_BITS(x, shift, count) (((x) >> (shift)) & ((1 << (count)) - 1))
+    #define WR_HAS_FLAG(x, flag) (((x) & (flag)) != 0)
+    #define WR_SHL(x, n) ((x) << (n))
+    #define WR_SHR(x, n) ((x) >> (n))
+    #define WR_MOD(a, b) int(uint(a) % uint(b))
+#endif
+
+// Built-ins GLSL ES 1.00 lacks; webrender_build renames the calls for it
+// (mix with a boolean selector, transpose, inverse, round).
+#if __VERSION__ == 100
+    float wr_mix(float a, float b, float t) { return a + (b - a) * t; }
+    vec2 wr_mix(vec2 a, vec2 b, float t) { return a + (b - a) * t; }
+    vec3 wr_mix(vec3 a, vec3 b, float t) { return a + (b - a) * t; }
+    vec4 wr_mix(vec4 a, vec4 b, float t) { return a + (b - a) * t; }
+    vec2 wr_mix(vec2 a, vec2 b, vec2 t) { return a + (b - a) * t; }
+    vec3 wr_mix(vec3 a, vec3 b, vec3 t) { return a + (b - a) * t; }
+    vec4 wr_mix(vec4 a, vec4 b, vec4 t) { return a + (b - a) * t; }
+    float wr_mix(float a, float b, bool t) { return t ? b : a; }
+    vec2 wr_mix(vec2 a, vec2 b, bvec2 t) { return vec2(t.x ? b.x : a.x, t.y ? b.y : a.y); }
+    vec3 wr_mix(vec3 a, vec3 b, bvec3 t) {
+        return vec3(t.x ? b.x : a.x, t.y ? b.y : a.y, t.z ? b.z : a.z);
+    }
+    vec4 wr_mix(vec4 a, vec4 b, bvec4 t) {
+        return vec4(t.x ? b.x : a.x, t.y ? b.y : a.y, t.z ? b.z : a.z, t.w ? b.w : a.w);
+    }
+
+    mat2 wr_transpose(mat2 m) {
+        return mat2(m[0][0], m[1][0], m[0][1], m[1][1]);
+    }
+    mat3 wr_transpose(mat3 m) {
+        return mat3(m[0][0], m[1][0], m[2][0], m[0][1], m[1][1], m[2][1],
+                    m[0][2], m[1][2], m[2][2]);
+    }
+    mat4 wr_transpose(mat4 m) {
+        return mat4(m[0][0], m[1][0], m[2][0], m[3][0], m[0][1], m[1][1], m[2][1], m[3][1],
+                    m[0][2], m[1][2], m[2][2], m[3][2], m[0][3], m[1][3], m[2][3], m[3][3]);
+    }
+
+    mat2 wr_inverse(mat2 m) {
+        return mat2(m[1][1], -m[0][1], -m[1][0], m[0][0]) /
+               (m[0][0] * m[1][1] - m[0][1] * m[1][0]);
+    }
+
+    float wr_round(float x) { return floor(x + 0.5); }
+    vec2 wr_round(vec2 x) { return floor(x + 0.5); }
+    vec3 wr_round(vec3 x) { return floor(x + 0.5); }
+    vec4 wr_round(vec4 x) { return floor(x + 0.5); }
+#endif
