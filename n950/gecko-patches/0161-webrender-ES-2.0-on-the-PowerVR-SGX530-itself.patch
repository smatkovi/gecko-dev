         debug_assert_eq!(vao.instance_stride as usize, mem::size_of::<V>());
 
         match repeat {
+            Some(count) if self.capabilities.is_gles2 => {
+                let target = gl::ARRAY_BUFFER;
+                self.gl.bind_buffer(target, vao.instance_vbo_id.0);
+                let stride = mem::size_of::<V>();
+                let src = unsafe {
+                    slice::from_raw_parts(instances.as_ptr() as *const u8, instances.len() * stride)
+                };
+                let mut buf = mem::take(&mut self.instance_scratch);
+                buf.clear();
+                for instance in src.chunks_exact(stride) {
+                    for _ in 0 .. count.get() {
+                        buf.extend_from_slice(instance);
+                    }
+                }
+                self.gl.buffer_data_untyped(
+                    target,
+                    buf.len() as _,
+                    buf.as_ptr() as *const _,
+                    usage_hint.to_gl(),
