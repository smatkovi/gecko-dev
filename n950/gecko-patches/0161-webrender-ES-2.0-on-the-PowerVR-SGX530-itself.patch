+/// `8U` -> `8`: ESSL 1 has no unsigned literals, and some compilers (PowerVR
+/// SGX) reject them even in a skipped #else.
+fn strip_uint_suffixes(s: &str) -> String {
+    let chars: Vec<char> = s.chars().collect();
+    let mut out = String::with_capacity(s.len());
+    let mut i = 0;
+    while i < chars.len() {
+        let c = chars[i];
+        let starts_number = c.is_ascii_digit() && (i == 0 || !is_ident_char(chars[i - 1]));
+        if !starts_number {
+            out.push(c);
+            i += 1;
+            continue;
+        }
+        while i < chars.len() && (chars[i].is_ascii_hexdigit() || chars[i] == 'x' || chars[i] == 'X') {
+            out.push(chars[i]);
+            i += 1;
+        }
+        if i < chars.len()
+            && (chars[i] == 'u' || chars[i] == 'U')
+            && !chars.get(i + 1).map_or(false, |&n| is_ident_char(n))
+        {
+            i += 1;
         }
-        out.push(c);
     }
-    (out, if closed { None } else { Some(depth) })
+    out
 }
 
