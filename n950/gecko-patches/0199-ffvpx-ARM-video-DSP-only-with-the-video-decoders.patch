From 97e5d41e5539399cd5fa5a37c097da562fbc3c74 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Fri, 13 Nov 2026 19:36:10 +0100
Subject: [PATCH] ffvpx: ARM video DSP only with the video decoders

On 32-bit ARM ffvpx is built for audio only (MOZ_FFVPX_AUDIOONLY), yet the
ARM directory built the VP8/VP9/H.264 DSP code too. Normally the linker
drops it, unused; a PGO-instrumented build keeps every function alive
through its profile data, and the VP8/VP9 assembly then lacks the tables
of the video decoders (ff_vpx_norm_shift, ff_vp8_dct_cat_prob,
ff_vp9_subpel_filters): libmozavcodec failed to link.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 media/ffvpx/libavcodec/arm/moz.build | 93 +++++++++++++++-------------
 1 file changed, 49 insertions(+), 44 deletions(-)

diff --git a/media/ffvpx/libavcodec/arm/moz.build b/media/ffvpx/libavcodec/arm/moz.build
index b023bc30a70f..188b436acc16 100644
--- a/media/ffvpx/libavcodec/arm/moz.build
+++ b/media/ffvpx/libavcodec/arm/moz.build
@@ -5,54 +5,59 @@
 SOURCES += [
     'flacdsp_arm.S',
     'flacdsp_init_arm.c',
-    'h264chroma_init_arm.c',
-    'h264cmc_neon.S',
-    'h264dsp_init_arm.c',
-    'h264dsp_neon.S',
-    'h264idct_neon.S',
-    'h264pred_init_arm.c',
-    'h264pred_neon.S',
-    'hpeldsp_arm.S',
-    'hpeldsp_armv6.S',
-    'hpeldsp_init_arm.c',
-    'hpeldsp_init_armv6.c',
-    'hpeldsp_init_neon.c',
-    'hpeldsp_neon.S',
-    'idctdsp_arm.S',
-    'idctdsp_armv6.S',
-    'idctdsp_init_arm.c',
-    'idctdsp_init_armv5te.c',
-    'idctdsp_init_armv6.c',
-    'idctdsp_init_neon.c',
-    'idctdsp_neon.S',
-    'jrevdct_arm.S',
     'mpegaudiodsp_fixed_armv6.S',
     'mpegaudiodsp_init_arm.c',
-    'simple_idct_arm.S',
-    'simple_idct_armv5te.S',
-    'simple_idct_armv6.S',
-    'simple_idct_neon.S',
-    'startcode_armv6.S',
-    'videodsp_armv5te.S',
-    'videodsp_init_arm.c',
-    'videodsp_init_armv5te.c',
-    'vp8_armv6.S',
-    'vp8dsp_armv6.S',
-    'vp8dsp_init_arm.c',
-    'vp8dsp_init_armv6.c',
-    'vp8dsp_init_neon.c',
-    'vp8dsp_neon.S',
-    'vp9dsp_init_10bpp_arm.c',
-    'vp9dsp_init_12bpp_arm.c',
-    'vp9dsp_init_arm.c',
-    'vp9itxfm_16bpp_neon.S',
-    'vp9itxfm_neon.S',
-    'vp9lpf_16bpp_neon.S',
-    'vp9lpf_neon.S',
-    'vp9mc_16bpp_neon.S',
-    'vp9mc_neon.S',
 ]
 
+# video DSP only with the video decoders; an instrumented (PGO) build keeps it alive
+if not CONFIG['MOZ_FFVPX_AUDIOONLY']:
+    SOURCES += [
+        'h264chroma_init_arm.c',
+        'h264cmc_neon.S',
+        'h264dsp_init_arm.c',
+        'h264dsp_neon.S',
+        'h264idct_neon.S',
+        'h264pred_init_arm.c',
+        'h264pred_neon.S',
+        'hpeldsp_arm.S',
+        'hpeldsp_armv6.S',
+        'hpeldsp_init_arm.c',
+        'hpeldsp_init_armv6.c',
+        'hpeldsp_init_neon.c',
+        'hpeldsp_neon.S',
+        'idctdsp_arm.S',
+        'idctdsp_armv6.S',
+        'idctdsp_init_arm.c',
+        'idctdsp_init_armv5te.c',
+        'idctdsp_init_armv6.c',
+        'idctdsp_init_neon.c',
+        'idctdsp_neon.S',
+        'jrevdct_arm.S',
+        'simple_idct_arm.S',
+        'simple_idct_armv5te.S',
+        'simple_idct_armv6.S',
+        'simple_idct_neon.S',
+        'startcode_armv6.S',
+        'videodsp_armv5te.S',
+        'videodsp_init_arm.c',
+        'videodsp_init_armv5te.c',
+        'vp8_armv6.S',
+        'vp8dsp_armv6.S',
+        'vp8dsp_init_arm.c',
+        'vp8dsp_init_armv6.c',
+        'vp8dsp_init_neon.c',
+        'vp8dsp_neon.S',
+        'vp9dsp_init_10bpp_arm.c',
+        'vp9dsp_init_12bpp_arm.c',
+        'vp9dsp_init_arm.c',
+        'vp9itxfm_16bpp_neon.S',
+        'vp9itxfm_neon.S',
+        'vp9lpf_16bpp_neon.S',
+        'vp9lpf_neon.S',
+        'vp9mc_16bpp_neon.S',
+        'vp9mc_neon.S',
+    ]
+
 FINAL_LIBRARY = 'mozavcodec'
 
 include('/media/ffvpx/ffvpxcommon.mozbuild')
-- 
