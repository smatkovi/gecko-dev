@@ -435,12 +437,17 @@ impl IBOId {
 }
 
 impl FBOId {
-    fn bind(&self, gl: &dyn gl::Gl, target: FBOTarget) {
-        let target = match target {
-            FBOTarget::Read => gl::READ_FRAMEBUFFER,
-            FBOTarget::Draw => gl::DRAW_FRAMEBUFFER,
-        };
-        gl.bind_framebuffer(target, self.0);
+    fn bind(&self, gl: &dyn gl::Gl, target: FBOTarget, gles2: bool) {
+        gl.bind_framebuffer(fbo_target(target, gles2), self.0);
+    }
+}
+
+/// ES 2.0 has one framebuffer binding for reading and drawing.
+fn fbo_target(target: FBOTarget, gles2: bool) -> gl::GLenum {
+    match target {
+        _ if gles2 => gl::FRAMEBUFFER,
+        FBOTarget::Read => gl::READ_FRAMEBUFFER,
+        FBOTarget::Draw => gl::DRAW_FRAMEBUFFER,
     }
 }
 
