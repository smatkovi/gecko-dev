From 727c01becdc8ea16ff36b523bd9044ec9b4f4e6b Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 14:59:21 +0100
Subject: [PATCH 162/162] wrench: load ES 2.0 functions from libGLESv2 and by
 OES/EXT names

An ES 2.0 EGL may not hand out core functions through
eglGetProcAddress, and ES 3.0 functions only under their extension
names (glGenVertexArraysOES).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/wr/wrench/Cargo.toml  |  1 +
 gfx/wr/wrench/src/main.rs | 23 ++++++++++++++++++++++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/gfx/wr/wrench/Cargo.toml b/gfx/wr/wrench/Cargo.toml
index 79e5ac10a444..7b2e3ac77592 100644
--- a/gfx/wr/wrench/Cargo.toml
+++ b/gfx/wr/wrench/Cargo.toml
@@ -60,6 +60,7 @@ android_logger = "0.14"
 
 [target.'cfg(all(unix, not(target_os = "android")))'.dependencies]
 font-loader = "0.11"
+libc = "0.2"
 
 # Configuration information used when building wrench as an APK.
 [package.metadata.android]
diff --git a/gfx/wr/wrench/src/main.rs b/gfx/wr/wrench/src/main.rs
index 369688486611..11ddf8005e11 100644
--- a/gfx/wr/wrench/src/main.rs
+++ b/gfx/wr/wrench/src/main.rs
@@ -551,9 +551,30 @@ fn build_context_attrs(
 
 fn load_gl_fns(is_gles: bool, gl_display: &impl GlDisplay) -> Rc<dyn gl::Gl> {
     if is_gles {
+        // An ES 2.0 driver (PowerVR SGX) may hand out core ES 2.0 functions
+        // only from libGLESv2 itself, and ES 3.0 ones only under their OES
+        // or EXT extension names.
+        let lib_name = CString::new("libGLESv2.so.2").unwrap();
+        let lib = unsafe { libc::dlopen(lib_name.as_ptr(), libc::RTLD_LAZY) };
+        let find = |name: &str| -> *const c_void {
+            let name = CString::new(name).unwrap();
+            let p = gl_display.get_proc_address(&name) as *const c_void;
+            if !p.is_null() || lib.is_null() {
+                return p;
+            }
+            unsafe { libc::dlsym(lib, name.as_ptr()) as *const c_void }
+        };
         unsafe {
             gl::GlesFns::load_with(|symbol| {
-                gl_display.get_proc_address(&CString::new(symbol).unwrap()) as *const _
+                let p = find(symbol);
+                if !p.is_null() {
+                    return p;
+                }
+                ["OES", "EXT"]
+                    .iter()
+                    .map(|suffix| find(&format!("{}{}", symbol, suffix)))
+                    .find(|p| !p.is_null())
+                    .unwrap_or(ptr::null())
             })
         }
     } else {
