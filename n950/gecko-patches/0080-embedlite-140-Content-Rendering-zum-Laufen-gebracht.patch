From 85e82e32b7d5e56f6ebed93eebab9082aac39002 Mon Sep 17 00:00:00 2001
From: sm <sebstianmatkovich@gmail.com>
Date: Wed, 19 Aug 2026 11:36:28 +0200
Subject: [PATCH 080/156] embedlite-140: Content-Rendering zum Laufen gebracht

- EmbedLitePuppetWidget::NeedsPaint: '|| mView'-Gate der Layers-Aera entfernt
  (im WR-140 laeuft Content-Paint ueber den ViewManager - vorher nie eine DisplayList)
- EmbedLiteViewChild::RecvSetIsActive: PresShell::Initialize nachgeholt
  (ohne DidInitialize bleibt Document::IsRenderingSuppressed dauerhaft true)
- GLContextEGL-Dtor: GLScreenBuffer vor MarkDestroyed abbauen (pure-virtual/Nullptr)
- EmbedLiteViewParent: APZ-Zoom-Handler stillgelegt (TreeManager nicht verdrahtet)
- nsWindow::PreRender: CBP-getriebene Frames am vis/act-Gate durchlassen
- dazu Diagnose-Instrumentierung (EL-A..Z16, Selbsttest, Vsync/Paint-Kette)
---
 gfx/gl/GLContextProviderEGL.cpp                |  7 +++++++
 gfx/thebes/SoftwareVsyncSource.cpp             |  3 +++
 gfx/thebes/VsyncSource.cpp                     |  4 ++++
 gfx/webrender_bindings/RenderCompositorEGL.cpp | 10 +++++++++-
 gfx/webrender_bindings/RenderCompositorOGL.cpp |  1 +
 gfx/webrender_bindings/RendererOGL.cpp         |  3 +++
 layout/base/PresShell.cpp                      |  2 ++
 layout/base/nsRefreshDriver.cpp                | 13 +++++++++++++
 widget/VsyncDispatcher.cpp                     |  4 ++++
 9 files changed, 46 insertions(+), 1 deletion(-)

diff --git a/gfx/gl/GLContextProviderEGL.cpp b/gfx/gl/GLContextProviderEGL.cpp
index 9ef1fc1caa6b..9960ad35f510 100644
--- a/gfx/gl/GLContextProviderEGL.cpp
+++ b/gfx/gl/GLContextProviderEGL.cpp
@@ -521,6 +521,13 @@ void GLContextEGL::OnMarkDestroyed() {
 }
 
 GLContextEGL::~GLContextEGL() {
+  // EmbedLite/0072: Screen (SwapChain/SharedSurfaces) VOR MarkDestroyed abbauen -
+  // ProducerRelease braucht lebende GL-Symbols und die EGL-vtable.
+  if (mScreen) {
+    MakeCurrent();
+    mScreen = nullptr;
+  }
+
   MarkDestroyed();
 
   // Wrapped context should not destroy eglContext/Surface
