From b88dd4bdfac0201c2a96e90dc9244a45777bcf4d Mon Sep 17 00:00:00 2001
From: fork <fork@local>
Date: Sat, 22 Aug 2026 20:38:20 +0000
Subject: [PATCH 132/156] Prompter: log length of the EmbedLite password prompt
 result

---
 toolkit/components/prompts/src/Prompter.sys.mjs | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/toolkit/components/prompts/src/Prompter.sys.mjs b/toolkit/components/prompts/src/Prompter.sys.mjs
index 8f9250314f22..bf45909f0aa3 100644
--- a/toolkit/components/prompts/src/Prompter.sys.mjs
+++ b/toolkit/components/prompts/src/Prompter.sys.mjs
@@ -1184,6 +1184,10 @@ class ModalPrompter {
           args.value = response.promptvalue;
         if (args.promptType == "promptPassword") {
           args.pass = response.password || "";
+          console.debug(
+            "EmbedLite promptPassword: accepted=" + !!response.accepted +
+            " length=" + args.pass.length
+          );
         }
         }
 
