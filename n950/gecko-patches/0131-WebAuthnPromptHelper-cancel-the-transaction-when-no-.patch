From c22804c95804f5687ff1ff3ace780eb6f252708b Mon Sep 17 00:00:00 2001
From: fork <fork@local>
Date: Sat, 22 Aug 2026 20:19:37 +0000
Subject: [PATCH 131/156] WebAuthnPromptHelper: cancel the transaction when no
 prompt UI is available

---
 toolkit/modules/WebAuthnPromptHelper.sys.mjs | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/toolkit/modules/WebAuthnPromptHelper.sys.mjs b/toolkit/modules/WebAuthnPromptHelper.sys.mjs
index f6be2e69ea5b..b0b69ff0ab25 100644
--- a/toolkit/modules/WebAuthnPromptHelper.sys.mjs
+++ b/toolkit/modules/WebAuthnPromptHelper.sys.mjs
@@ -383,6 +383,9 @@ export let WebAuthnPromptHelper = {
     // Embedders without the desktop doorhanger UI (e.g. EmbedLite) only get
     // the modal PIN prompts; the informational prompts are skipped.
     if (!browsingContext.topChromeWindow?.PopupNotifications) {
+      // Nothing can be shown; cancel the transaction instead of leaving the
+      // authenticator waiting for an answer that never comes.
+      lazy.webauthnService.cancel(tid);
       return;
     }
 
