From 14c508ae17e885c359f2676b4cfc8ab6e8a6a840 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Thu, 12 Nov 2026 12:27:37 +0100
Subject: [PATCH 191/191] webrender: name the shader variant and GL error when
 a program fails to link

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/wr/webrender/src/device/gl.rs | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/gfx/wr/webrender/src/device/gl.rs b/gfx/wr/webrender/src/device/gl.rs
index fc03e8715cbd..47fc3cbf3505 100644
--- a/gfx/wr/webrender/src/device/gl.rs
+++ b/gfx/wr/webrender/src/device/gl.rs
@@ -2821,8 +2821,9 @@ impl Device {
             if link_status[0] == 0 {
                 let error_log = self.gl.get_program_info_log(program.id);
                 error!(
-                    "Failed to link shader program: {}\n{}",
-                    &info.base_filename,
+                    "Failed to link shader program: {} (gl error 0x{:x})\n{}",
+                    info.full_name(),
+                    self.gl.get_error(),
                     error_log
                 );
                 self.gl.delete_program(program.id);
-- 
