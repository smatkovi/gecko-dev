From 5d35c60b8e7578d6d1b8c4d46f4febbfbd6ca350 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Thu, 12 Nov 2026 16:35:54 +0100
Subject: [PATCH] webrender_bindings: 512x512 texture cache pages on OpenGL ES
 2.0

The PowerVR SGX530's driver rearranges (twiddles) a whole texture on the
CPU, byte by byte, for every glTexSubImage2D into it. With the main
window's 2048x2048 cache pages each new glyph or image cost seconds of the
render thread (perf on the N950: 73 % of it in that loop, the content
waiting on pending transactions in between); with 512x512 pages, as other
windows already use, 13 %.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/webrender_bindings/src/bindings.rs | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/gfx/webrender_bindings/src/bindings.rs b/gfx/webrender_bindings/src/bindings.rs
index 2663ece0f7e8..c57bc020d19d 100644
--- a/gfx/webrender_bindings/src/bindings.rs
+++ b/gfx/webrender_bindings/src/bindings.rs
@@ -2133,7 +2133,11 @@ pub extern "C" fn wr_window_new(
         None
     };
 
-    let texture_cache_config = if is_main_window {
+    // The PowerVR SGX530's driver (OpenGL ES 2.0) rearranges a whole texture
+    // on the CPU for every glTexSubImage2D into it: on a 2048x2048 page each
+    // new glyph or image costs seconds, on a 512x512 one a fraction of that.
+    let gles2 = !software && gl.get_string(gl::VERSION).starts_with("OpenGL ES 2.");
+    let texture_cache_config = if is_main_window && !gles2 {
         TextureCacheConfig::DEFAULT
     } else {
         TextureCacheConfig {
