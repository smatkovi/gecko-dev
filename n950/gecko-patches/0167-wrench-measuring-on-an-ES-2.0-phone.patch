+/// WRENCH_GL_RING: the names of the last GL calls, printed on SIGSEGV or
+/// SIGABRT, to find the call a driver crashes in.
+mod glring {
+    use gleam::gl;
+    use std::rc::Rc;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    const N: usize = 64;
+    static PTRS: [AtomicUsize; N] = [const { AtomicUsize::new(0) }; N];
+    static LENS: [AtomicUsize; N] = [const { AtomicUsize::new(0) }; N];
+    static NEXT: AtomicUsize = AtomicUsize::new(0);
+
+    fn record(name: &str) {
+        let i = NEXT.fetch_add(1, Ordering::Relaxed) % N;
+        PTRS[i].store(name.as_ptr() as usize, Ordering::Relaxed);
+        LENS[i].store(name.len(), Ordering::Relaxed);
+    }
+
+    extern "C" fn dump(sig: libc::c_int) {
+        let n = NEXT.load(Ordering::Relaxed);
+        let msg = b"--- last GL calls (oldest first) ---\n";
+        unsafe {
+            libc::write(2, msg.as_ptr() as *const _, msg.len());
+            for k in n.saturating_sub(N) .. n {
+                let i = k % N;
+                let p = PTRS[i].load(Ordering::Relaxed);
+                let l = LENS[i].load(Ordering::Relaxed);
+                libc::write(2, p as *const _, l);
+                libc::write(2, b"\n".as_ptr() as *const _, 1);
+            }
+            libc::signal(sig, libc::SIG_DFL);
+            libc::raise(sig);
+        }
+    }
+
+    pub fn wrap(fns: Rc<dyn gl::Gl>) -> Rc<dyn gl::Gl> {
+        if std::env::var_os("WRENCH_GL_RING").is_none() {
+            return fns;
+        }
+        unsafe {
+            libc::signal(libc::SIGSEGV, dump as libc::sighandler_t);
+            libc::signal(libc::SIGABRT, dump as libc::sighandler_t);
+        }
+        gl::ProfilingGl::wrap(fns, std::time::Duration::ZERO, |name, _| record(name))
+    }
+}
+
+/// EGL first where GLX would be tried first: an OpenGL ES driver such as
+/// the PowerVR SGX's is reached through EGL, its GLX path is not stable.
+fn egl_preference() -> glutin_winit::ApiPreference {
+    if std::env::var_os("WRENCH_GLX").is_some() {
+        glutin_winit::ApiPreference::FallbackEgl
+    } else {
+        glutin_winit::ApiPreference::PreferEgl
+    }
+}
