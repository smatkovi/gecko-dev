From ebafab57a6cc80c9696324d2f70206a34d9ae214 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 23:08:15 +0100
Subject: [PATCH] webrender: ES 2.0 primitive headers in one float texture

The PowerVR SGX530 fails to link a program whose two stages sample 8
textures between them ("Uniform variable sGpuBufferF type/precision does
not match"): brush_blend's alpha pass, now that its fragment stage reads
filter data, sampled 5 in the vertex and 3 in the fragment stage. On
ES 2.0 the renderer uploads each primitive header's float and integer
halves together into the float header texture (the integers as floats,
which the ES 2.0 upload made of them anyway), and the shaders read both
from sPrimitiveHeadersF: every brush and text shader samples one texture
fewer. All 51 ES 2.0 shader variants now compile and link on the SGX530.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/wr/webrender/res/prim_shared.glsl   |  9 ++-
 gfx/wr/webrender/src/renderer/vertex.rs | 86 +++++++++++++++++++------
 2 files changed, 74 insertions(+), 21 deletions(-)

diff --git a/gfx/wr/webrender/res/prim_shared.glsl b/gfx/wr/webrender/res/prim_shared.glsl
index 4dcc584e2074..a21cc79ae5bd 100644
--- a/gfx/wr/webrender/res/prim_shared.glsl
+++ b/gfx/wr/webrender/res/prim_shared.glsl
@@ -45,7 +45,9 @@ uniform HIGHP_SAMPLER_FLOAT isampler2D sPrimitiveHeadersI;
 PER_INSTANCE attribute ivec4 aData;
 
 #if __VERSION__ == 100
-#define VECS_PER_PRIM_HEADER_F 2
+// ES 2.0: the integer half follows in the same float texture (texels 2 and 3,
+// see PrimitiveHeaderGles2), so no shader samples sPrimitiveHeadersI.
+#define VECS_PER_PRIM_HEADER_F 4
 #else
 #define VECS_PER_PRIM_HEADER_F 2U
 #endif
@@ -106,9 +108,14 @@ PrimitiveHeader fetch_prim_header(int index) {
     ph.local_rect = RectWithEndpoint(local_rect.xy, local_rect.zw);
     ph.local_clip_rect = RectWithEndpoint(local_clip_rect.xy, local_clip_rect.zw);
 
+#if __VERSION__ == 100
+    ivec4 data0 = ivec4(TEXEL_FETCH(sPrimitiveHeadersF, uv_f, 0, ivec2(2, 0)));
+    ivec4 data1 = ivec4(TEXEL_FETCH(sPrimitiveHeadersF, uv_f, 0, ivec2(3, 0)));
+#else
     ivec2 uv_i = get_fetch_uv(index, VECS_PER_PRIM_HEADER_I);
     ivec4 data0 = TEXEL_FETCH(sPrimitiveHeadersI, uv_i, 0, ivec2(0, 0));
     ivec4 data1 = TEXEL_FETCH(sPrimitiveHeadersI, uv_i, 0, ivec2(1, 0));
+#endif
     ph.z = float(data0.x);
     ph.specific_prim_address = data0.y;
     ph.transform_id = data0.z;
diff --git a/gfx/wr/webrender/src/renderer/vertex.rs b/gfx/wr/webrender/src/renderer/vertex.rs
index 35f693646c5a..381e1933ab04 100644
--- a/gfx/wr/webrender/src/renderer/vertex.rs
+++ b/gfx/wr/webrender/src/renderer/vertex.rs
@@ -305,9 +305,18 @@ impl<T> VertexDataTexture<T> {
     }
 }
 
+/// OpenGL ES 2.0: a primitive header's float and integer halves in one float
+/// texture, the integers as floats (which the ES 2.0 upload makes of them
+/// anyway), so that shaders sample one texture fewer: the PowerVR SGX530
+/// fails to link programs that sample 8 between their two stages.
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct PrimitiveHeaderGles2([f32; 16]);
+
 pub struct VertexDataTextures {
     prim_header_f_texture: VertexDataTexture<PrimitiveHeaderF>,
     prim_header_i_texture: VertexDataTexture<PrimitiveHeaderI>,
+    prim_header_gles2_texture: VertexDataTexture<PrimitiveHeaderGles2>,
     transforms_texture: VertexDataTexture<TransformData>,
     render_task_texture: VertexDataTexture<RenderTaskData>,
 }
@@ -317,23 +326,50 @@ impl VertexDataTextures {
         VertexDataTextures {
             prim_header_f_texture: VertexDataTexture::new(api::ImageFormat::RGBAF32),
             prim_header_i_texture: VertexDataTexture::new(api::ImageFormat::RGBAI32),
+            prim_header_gles2_texture: VertexDataTexture::new(api::ImageFormat::RGBAF32),
             transforms_texture: VertexDataTexture::new(api::ImageFormat::RGBAF32),
             render_task_texture: VertexDataTexture::new(api::ImageFormat::RGBAF32),
         }
     }
 
     pub fn update(&mut self, device: &mut Device, pbo_pool: &mut UploadPBOPool, frame: &mut Frame) {
+        let is_gles2 = device.get_capabilities().is_gles2;
+        let mut gles2_headers: FrameVec<PrimitiveHeaderGles2> = frame.allocator_memory.new_vec();
+        if is_gles2 {
+            debug_assert_eq!(mem::size_of::<PrimitiveHeaderF>(), 32);
+            debug_assert_eq!(mem::size_of::<PrimitiveHeaderI>(), 32);
+            let headers = &frame.prim_headers;
+            gles2_headers.reserve(headers.headers_float.len());
+            for (f, i) in headers.headers_float.iter().zip(headers.headers_int.iter()) {
+                let f = unsafe { &*(f as *const PrimitiveHeaderF as *const [f32; 8]) };
+                let i = unsafe { &*(i as *const PrimitiveHeaderI as *const [i32; 8]) };
+                let mut texels = [0.0; 16];
+                texels[.. 8].copy_from_slice(f);
+                for (t, v) in texels[8 ..].iter_mut().zip(i.iter()) {
+                    *t = *v as f32;
+                }
+                gles2_headers.push(PrimitiveHeaderGles2(texels));
+            }
+        }
         let mut texture_uploader = device.upload_texture(pbo_pool);
-        self.prim_header_f_texture.update(
-            device,
-            &mut texture_uploader,
-            &mut frame.prim_headers.headers_float,
-        );
-        self.prim_header_i_texture.update(
-            device,
-            &mut texture_uploader,
-            &mut frame.prim_headers.headers_int,
-        );
+        if is_gles2 {
+            self.prim_header_gles2_texture.update(
+                device,
+                &mut texture_uploader,
+                &mut gles2_headers,
+            );
+        } else {
+            self.prim_header_f_texture.update(
+                device,
+                &mut texture_uploader,
+                &mut frame.prim_headers.headers_float,
+            );
+            self.prim_header_i_texture.update(
+                device,
+                &mut texture_uploader,
+                &mut frame.prim_headers.headers_int,
+            );
+        }
         self.transforms_texture
             .update(device, &mut texture_uploader, &mut frame.transform_palette);
         self.render_task_texture.update(
@@ -346,16 +382,24 @@ impl VertexDataTextures {
         // we can borrow the textures to bind them.
         texture_uploader.flush(device);
 
-        device.bind_texture(
-            super::TextureSampler::PrimitiveHeadersF,
-            &self.prim_header_f_texture.texture(),
-            Swizzle::default(),
-        );
-        device.bind_texture(
-            super::TextureSampler::PrimitiveHeadersI,
-            &self.prim_header_i_texture.texture(),
-            Swizzle::default(),
-        );
+        if is_gles2 {
+            device.bind_texture(
+                super::TextureSampler::PrimitiveHeadersF,
+                &self.prim_header_gles2_texture.texture(),
+                Swizzle::default(),
+            );
+        } else {
+            device.bind_texture(
+                super::TextureSampler::PrimitiveHeadersF,
+                &self.prim_header_f_texture.texture(),
+                Swizzle::default(),
+            );
+            device.bind_texture(
+                super::TextureSampler::PrimitiveHeadersI,
+                &self.prim_header_i_texture.texture(),
+                Swizzle::default(),
+            );
+        }
         device.bind_texture(
             super::TextureSampler::TransformPalette,
             &self.transforms_texture.texture(),
@@ -371,6 +415,7 @@ impl VertexDataTextures {
     pub fn size_in_bytes(&self) -> usize {
         self.prim_header_f_texture.size_in_bytes()
             + self.prim_header_i_texture.size_in_bytes()
+            + self.prim_header_gles2_texture.size_in_bytes()
             + self.transforms_texture.size_in_bytes()
             + self.render_task_texture.size_in_bytes()
     }
@@ -379,6 +424,7 @@ impl VertexDataTextures {
         self.transforms_texture.deinit(device);
         self.prim_header_f_texture.deinit(device);
         self.prim_header_i_texture.deinit(device);
+        self.prim_header_gles2_texture.deinit(device);
         self.render_task_texture.deinit(device);
     }
 }
-- 
2.56.0

