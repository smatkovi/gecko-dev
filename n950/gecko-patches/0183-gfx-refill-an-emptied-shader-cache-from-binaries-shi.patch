From 6ffe37663635a5e808a1d73f3f3e28bee7b56b8f Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 22:31:02 +0100
Subject: [PATCH] gfx: refill an emptied shader cache from binaries shipped
 with the application

When the shader cache check finds another build, device or driver (or a
new profile) and empties the profile's shader-cache, program binaries in
shader-cache/ next to the application are copied in, if their stamp file
names this build, pointer size, device and driver; the profile cache gets
the same stamp, so a cache filled on the target device can be shipped as
is. Otherwise the shader warmup fills it during the session, and it now
skips a shader that fails to compile instead of stopping at the first
(PowerVR SGX530 under OpenGL ES 2.0: a few have more varyings than it
has), giving up after eight failures.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/thebes/gfxUtils.cpp                     | 24 +++++++++++++++++
 gfx/webrender_bindings/src/bindings.rs      | 30 +++++++++++++++++----
 gfx/webrender_bindings/src/program_cache.rs | 29 ++++++++++++++++++++
 3 files changed, 78 insertions(+), 5 deletions(-)

diff --git a/gfx/thebes/gfxUtils.cpp b/gfx/thebes/gfxUtils.cpp
index 6c19c572f06e..841584bb182e 100644
--- a/gfx/thebes/gfxUtils.cpp
+++ b/gfx/thebes/gfxUtils.cpp
@@ -40,6 +40,8 @@
 #include "mozilla/StaticPrefs_layout.h"
 #include "mozilla/UniquePtrExtensions.h"
 #include "mozilla/webrender/webrender_ffi.h"
+#include "nsDirectoryServiceDefs.h"
+#include "nsDirectoryServiceUtils.h"
 #include "nsAppRunner.h"
 #include "nsComponentManagerUtils.h"
 #include "nsIClipboardHelper.h"
@@ -1707,6 +1709,28 @@ void gfxUtils::RemoveShaderCacheFromDiskIfNecessary() {
   Preferences::SetInt(GFX_SHADER_CHECK_PTR_SIZE_PREF, ptrSize);
   Preferences::SetString(GFX_SHADER_CHECK_DEVICE_ID_PREF, deviceID);
   Preferences::SetString(GFX_SHADER_CHECK_DRIVER_VERSION_PREF, driverVersion);
+
+  // Program binaries shipped next to the application (compiled once on the
+  // target device, e.g. the N950's PowerVR SGX530 at about 1.5 s a program)
+  // refill the emptied cache when they were made for this build, device and
+  // driver; otherwise the shader warmup compiles them during this session.
+  nsCOMPtr<nsIFile> shippedDir;
+  if (NS_SUCCEEDED(
+          NS_GetSpecialDirectory(NS_GRE_DIR, getter_AddRefs(shippedDir))) &&
+      NS_SUCCEEDED(shippedDir->AppendNative("shader-cache"_ns))) {
+    nsAutoString shippedPath;
+    shippedDir->GetPath(shippedPath);
+    nsAutoString stamp;
+    stamp.AppendASCII(buildID.get());
+    stamp.Append(u'\n');
+    stamp.AppendInt(ptrSize);
+    stamp.Append(u'\n');
+    stamp.Append(deviceID);
+    stamp.Append(u'\n');
+    stamp.Append(driverVersion);
+    stamp.Append(u'\n');
+    wr::seed_program_binary_disk_cache(&path, &shippedPath, &stamp);
+  }
 }
 
 /* static */
diff --git a/gfx/webrender_bindings/src/bindings.rs b/gfx/webrender_bindings/src/bindings.rs
index baa9a55f5733..cfa25bafa007 100644
--- a/gfx/webrender_bindings/src/bindings.rs
+++ b/gfx/webrender_bindings/src/bindings.rs
@@ -33,7 +33,7 @@ use webrender::ChunkPool;
 use euclid::SideOffsets2D;
 use moz2d_renderer::Moz2dBlobImageHandler;
 use nsstring::nsAString;
-use program_cache::{remove_disk_cache, WrProgramCache};
+use program_cache::{remove_disk_cache, seed_disk_cache, WrProgramCache};
 use tracy_rs::register_thread_with_profiler;
 use webrender::sw_compositor::SwCompositor;
 use webrender::{
@@ -1241,6 +1241,21 @@ pub unsafe extern "C" fn remove_program_binary_disk_cache(prof_path: &nsAString)
     }
 }
 
+#[no_mangle]
+pub unsafe extern "C" fn seed_program_binary_disk_cache(
+    prof_path: &nsAString,
+    shipped_path: &nsAString,
+    stamp: &nsAString,
+) -> bool {
+    match seed_disk_cache(prof_path, shipped_path, &String::from_utf16_lossy(stamp.as_ref())) {
+        Ok(seeded) => seeded,
+        Err(err) => {
+            error!("Failed to seed the program binary disk cache: {}", err);
+            false
+        },
+    }
+}
+
 // This matches IsEnvSet in gfxEnv.h
 fn env_var_to_bool(key: &'static str) -> bool {
     env::var(key).ok().map_or(false, |v| !v.is_empty())
@@ -1952,6 +1967,7 @@ impl PartialPresentCompositor for WrPartialPresentCompositor {
 pub struct WrShaders {
     shaders: SharedShaders,
     shaders_to_precache: PendingShadersToPrecache,
+    warmup_failures: u32,
     device: Device,
 }
 
@@ -4586,6 +4602,7 @@ pub extern "C" fn wr_shaders_new(
     let shaders = WrShaders {
         shaders: Rc::new(RefCell::new(shaders)),
         shaders_to_precache,
+        warmup_failures: 0,
         device,
     };
 
@@ -4623,10 +4640,13 @@ pub extern "C" fn wr_shaders_resume_warmup(shaders: &mut WrShaders) -> bool {
                 gfx_critical_note(msg.as_ptr());
             }
 
-            // Don't ask for another call to resume warmup; if one shader failed
-            // to compile it's likely that we will run into similar errors with
-            // the rest of the shaders.
-            false
+            // Go on with the next shader: a GPU may compile all but a few of
+            // them (the PowerVR SGX530 under OpenGL ES 2.0 has too few varying
+            // vectors for some), and the warmup is what fills the disk cache.
+            // Give up after a handful of failures, which suggests a driver
+            // that will not compile the rest either.
+            shaders.warmup_failures += 1;
+            shaders.warmup_failures < 8
         },
     };
 
diff --git a/gfx/webrender_bindings/src/program_cache.rs b/gfx/webrender_bindings/src/program_cache.rs
index 63fb755700ac..c425771b4bcc 100644
--- a/gfx/webrender_bindings/src/program_cache.rs
+++ b/gfx/webrender_bindings/src/program_cache.rs
@@ -346,6 +346,35 @@ impl WrProgramCache {
     }
 }
 
+const STAMP_FILENAME: &str = "stamp";
+
+/// Gives a freshly emptied profile shader cache the program binaries shipped
+/// next to the application, compiled once on the target device. `stamp`
+/// holds what the cache is checked against (build, pointer size, device and
+/// driver); it is written into the profile cache, and the shipped binaries
+/// (with the stamp file that came with them) are copied only when their
+/// stamp is the same. Returns whether they were.
+pub fn seed_disk_cache(prof_path: &nsAString, shipped_path: &nsAString, stamp: &str) -> Result<bool, Error> {
+    let Some(cache_path) = get_cache_path_from_prof_path(prof_path) else {
+        return Ok(false);
+    };
+    create_dir_all(&cache_path)?;
+    File::create(cache_path.join(STAMP_FILENAME))?.write_all(stamp.as_bytes())?;
+
+    let shipped = PathBuf::from(String::from_utf16_lossy(shipped_path.as_ref()));
+    match read_to_string(shipped.join(STAMP_FILENAME)) {
+        Ok(shipped_stamp) if shipped_stamp == stamp => {},
+        _ => return Ok(false),
+    }
+    for entry in read_dir(&shipped)? {
+        let entry = entry?;
+        if entry.file_name() != STAMP_FILENAME && entry.file_type()?.is_file() {
+            std::fs::copy(entry.path(), cache_path.join(entry.file_name()))?;
+        }
+    }
+    Ok(true)
+}
+
 pub fn remove_disk_cache(prof_path: &nsAString) -> Result<(), Error> {
     use std::time::Instant;
 
