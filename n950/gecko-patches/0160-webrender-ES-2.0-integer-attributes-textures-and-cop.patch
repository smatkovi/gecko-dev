+    fn gl_describe_format_gles2(&self, format: ImageFormat) -> FormatDesc {
+        let (internal, pixel_type) = match format {
+            ImageFormat::R8 => (gl::RED, gl::UNSIGNED_BYTE),
+            ImageFormat::R16 => (gl::RED, gl::UNSIGNED_SHORT),
