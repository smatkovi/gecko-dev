+impl<'a> TextureUploader<'a> {
+    /// ES 2.0 has no GL_UNPACK_ROW_LENGTH and no integer textures: rows are
+    /// packed and 32-bit integers converted to floats on the CPU. Uploads
+    /// are immediate, so the chunk's offset is the data's address.
+    fn update_impl_gles2(device: &mut Device, chunk: UploadChunk) {
+        let format = chunk.format_override.unwrap_or(chunk.texture.format);
+        let desc = device.gl_describe_format(format);
+        let size = chunk.rect.size();
+        if size.width <= 0 || size.height <= 0 {
+            return;
+        }
+        let row = size.width as usize * format.bytes_per_pixel() as usize;
+        let src_stride = chunk.stride.map_or(row, |stride| stride as usize);
+        let rows = size.height as usize;
+        let src = unsafe {
+            slice::from_raw_parts(chunk.offset as *const u8, (rows - 1) * src_stride + row)
+        };
+        let packed: Vec<u8>;
+        let data = if format == ImageFormat::RGBAI32 {
+            packed = (0 .. rows)
+                .flat_map(|y| src[y * src_stride .. y * src_stride + row].chunks_exact(4))
+                .flat_map(|v| (i32::from_ne_bytes([v[0], v[1], v[2], v[3]]) as f32).to_ne_bytes())
+                .collect();
+            &packed[..]
+        } else if src_stride != row {
+            packed = (0 .. rows)
+                .flat_map(|y| src[y * src_stride .. y * src_stride + row].iter().cloned())
+                .collect();
+            &packed[..]
+        } else {
+            src
+        };
+        let pos = chunk.rect.min;
+        device.gl.tex_sub_image_2d(
+            chunk.texture.target,
+            0,
+            pos.x as _,
+            pos.y as _,
+            size.width as _,
+            size.height as _,
+            desc.external,
+            desc.pixel_type,
+            data,
+        );
+        if chunk.texture.filter == TextureFilter::Trilinear {
+            device.gl.generate_mipmap(chunk.texture.target);
+        }
+    }
+}
