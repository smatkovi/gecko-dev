+    /// The attribute as an OpenGL ES 2.0 context reads it: name, component
+    /// count and byte offset of each part. Integers come as the unsigned
+    /// 16-bit halves of their 32-bit values, two values per part, as
+    /// webrender_build declares them (`<name>_lh0`, `<name>_lh1`); a 16-bit
+    /// value fills only the low half.
+    fn gles2_parts(&self) -> Vec<(String, gl::GLint, gl::GLuint)> {
+        match self.kind {
+            VertexAttributeKind::I32 => {
+                let halves = 2 * self.count;
+                (0 .. (halves + 3) / 4)
+                    .map(|k| (format!("{}_lh{}", self.name, k), (halves - 4 * k).min(4) as gl::GLint, 8 * k))
+                    .collect()
+            }
+            VertexAttributeKind::U16 => {
+                debug_assert_eq!(self.count, 1);
+                vec![(format!("{}_lh0", self.name), 1, 0)]
+            }
+            _ => vec![(self.name.to_string(), self.count as gl::GLint, 0)],
+        }
+    }
