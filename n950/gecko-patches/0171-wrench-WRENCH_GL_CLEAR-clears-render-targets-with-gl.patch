From b8903bc38fdee5e7776a5eca04593301214c52c0 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 18:30:02 +0100
Subject: [PATCH 171/171] wrench: WRENCH_GL_CLEAR clears render targets with
 glClear

Instead of quads (clear_caches_with_quads), to compare both on a GPU.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/wr/wrench/src/wrench.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/gfx/wr/wrench/src/wrench.rs b/gfx/wr/wrench/src/wrench.rs
index e0fc3ea9aa7b..f2a496091244 100644
--- a/gfx/wr/wrench/src/wrench.rs
+++ b/gfx/wr/wrench/src/wrench.rs
@@ -277,7 +277,7 @@ impl Wrench {
             dump_shader_source,
             // SWGL doesn't support the GL_ALWAYS depth comparison function used by
             // `clear_caches_with_quads`, but scissored clears work well.
-            clear_caches_with_quads: !window.is_software(),
+            clear_caches_with_quads: !window.is_software() && std::env::var_os("WRENCH_GL_CLEAR").is_none(),
             compositor_config,
             enable_debugger: true,
             panic_on_gl_error: std::env::var_os("WRENCH_GL_ERRORS").is_some(),
-- 
