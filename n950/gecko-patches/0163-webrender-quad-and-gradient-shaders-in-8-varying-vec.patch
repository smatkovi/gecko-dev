From 4e7374b255cf6f87135dc966d7ac10a099d43817 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 15:14:46 +0100
Subject: [PATCH 163/164] webrender: quad and gradient shaders in 8 varying
 vectors on ES 2.0

The PowerVR SGX530 has 8 varying vectors; ps_quad_gradient used 10
("Failed to allocate varyings"). For GLSL ES 1.00 only:
- ps_quad: the flags share a vector with the local position (packed
  into z), w is left to the pattern (v_quad_spare),
- ps_quad_gradient: the header goes into the unused v_flat_data.w
  (kind, extend mode, stop count) and v_quad_spare (colors address).
The two-stop fast path stays, sparing the fragment shader buffer reads.

The ES 1.00 vertex shader's main wrapper runs WR_VS_FINISH and
WR_VS_FINISH2, where a shader packs its integers into these components.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/wr/webrender/res/ps_quad.glsl          | 23 +++++++++++++++++++++-
 gfx/wr/webrender/res/ps_quad_gradient.glsl | 19 ++++++++++++++++++
 gfx/wr/webrender_build/src/shader.rs       |  2 ++
 3 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/gfx/wr/webrender/res/ps_quad.glsl b/gfx/wr/webrender/res/ps_quad.glsl
index 5eea2a7fee6c..11ad872eda13 100644
--- a/gfx/wr/webrender/res/ps_quad.glsl
+++ b/gfx/wr/webrender/res/ps_quad.glsl
@@ -45,12 +45,33 @@ flat varying mediump vec4 v_color;
 // z: is_mask
 // w: has edge flags
 // x,y are avaible for patterns to use.
+#if __VERSION__ == 100
+// ES 2.0 GPUs may have only 8 varying vectors (PowerVR SGX530): the local
+// position and the flags share one, packed into z, and w is left to the
+// pattern (v_quad_spare).
+varying highp vec4 v_local_pos_flags;
+#define vLocalPos v_local_pos_flags.xy
+#define v_quad_spare v_local_pos_flags.w
+#ifdef WR_VERTEX_SHADER
+ivec4 v_flags;
+#define WR_VS_FINISH \
+    v_local_pos_flags.z = float(v_flags.z + 2 * v_flags.w + 4 * v_flags.x + 1024 * v_flags.y);
+#else
+ivec4 wr_quad_flags() {
+    float f = floor(v_local_pos_flags.z + 0.5);
+    return ivec4(mod(floor(f / 4.0), 256.0), floor(f / 1024.0),
+                 mod(f, 2.0), mod(floor(f / 2.0), 2.0));
+}
+#define v_flags wr_quad_flags()
+#endif
+#else
 flat varying lowp ivec4 v_flags;
+#endif
 #define v_flags_is_mask v_flags.z
 #define v_flags_has_edge_mask v_flags.w
 
 
-#ifndef SWGL_ANTIALIAS
+#if !defined(SWGL_ANTIALIAS) && __VERSION__ != 100
 varying highp vec2 vLocalPos;
 #endif
 
diff --git a/gfx/wr/webrender/res/ps_quad_gradient.glsl b/gfx/wr/webrender/res/ps_quad_gradient.glsl
index 26bd6b6364a1..9abc1248ac25 100644
--- a/gfx/wr/webrender/res/ps_quad_gradient.glsl
+++ b/gfx/wr/webrender/res/ps_quad_gradient.glsl
@@ -14,10 +14,29 @@
 #define GRADIENT_KIND_CONIC  2
 
 // All of the integer varyings are packed into this header (see decode_gradient_header).
+#if __VERSION__ != 100
 flat varying highp ivec4 v_gradient_header;
+#endif
 // Gradient-specific varying parameters are packed into these two varyings.
 varying highp vec4 v_interpolated_data;
 flat varying highp vec4 v_flat_data;
+#if __VERSION__ == 100
+// ES 2.0, 8 varying vectors: the header goes into v_flat_data.w (kind,
+// extend mode, stop count) and the quad's spare component (colors address).
+#ifdef WR_VERTEX_SHADER
+ivec4 v_gradient_header;
+#define WR_VS_FINISH2 \
+    v_flat_data.w = float(v_gradient_header.x + 4 * v_gradient_header.z + 16 * v_gradient_header.y); \
+    v_quad_spare = float(v_gradient_header.w);
+#else
+ivec4 wr_gradient_header() {
+    float h = floor(v_flat_data.w + 0.5);
+    return ivec4(mod(h, 4.0), floor(h / 16.0), mod(floor(h / 4.0), 4.0),
+                 floor(v_quad_spare + 0.5));
+}
+#define v_gradient_header wr_gradient_header()
+#endif
+#endif
 // The first four stop offsets provided to the fragment shader to reduce the
 // number of gpu buffer reads in the common case.
 flat varying mediump vec4 v_stop_offsets;
diff --git a/gfx/wr/webrender_build/src/shader.rs b/gfx/wr/webrender_build/src/shader.rs
index d1a023c84f6c..2ba8f1a5d56b 100644
--- a/gfx/wr/webrender_build/src/shader.rs
+++ b/gfx/wr/webrender_build/src/shader.rs
@@ -195,6 +195,8 @@ impl Gles2Rewriter {
                 name, name, float_ty, name
             ));
         }
+        out.push_str("#ifdef WR_VS_FINISH\n    WR_VS_FINISH\n#endif\n");
+        out.push_str("#ifdef WR_VS_FINISH2\n    WR_VS_FINISH2\n#endif\n");
         out.push_str("}\n");
         out
     }
-- 
