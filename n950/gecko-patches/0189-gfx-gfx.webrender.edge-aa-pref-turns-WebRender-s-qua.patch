From 63a5d689f92ffb80063c083209e8b964cd0e44dc Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Thu, 12 Nov 2026 09:08:50 +0100
Subject: [PATCH 189/189] gfx: gfx.webrender.edge-aa pref turns WebRender's
 quad edge anti-aliasing off

For weak GPUs: on the PowerVR SGX530 rotated content rasterises three
times as fast without it (WebRender's disable_edge_aa), with jagged edges
on rotated, skewed and SVG shapes only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/webrender_bindings/src/bindings.rs   | 1 +
 modules/libpref/init/StaticPrefList.yaml | 9 +++++++++
 2 files changed, 10 insertions(+)

diff --git a/gfx/webrender_bindings/src/bindings.rs b/gfx/webrender_bindings/src/bindings.rs
index cfa25bafa007..2663ece0f7e8 100644
--- a/gfx/webrender_bindings/src/bindings.rs
+++ b/gfx/webrender_bindings/src/bindings.rs
@@ -2154,6 +2154,7 @@ pub extern "C" fn wr_window_new(
 
     let opts = WebRenderOptions {
         enable_aa: true,
+        disable_edge_aa: !static_prefs::pref!("gfx.webrender.edge-aa"),
         enable_subpixel_aa,
         support_low_priority_transactions,
         allow_texture_swizzling,
diff --git a/modules/libpref/init/StaticPrefList.yaml b/modules/libpref/init/StaticPrefList.yaml
index 6068a68898d6..04a41a518a10 100644
--- a/modules/libpref/init/StaticPrefList.yaml
+++ b/modules/libpref/init/StaticPrefList.yaml
@@ -8684,6 +8684,15 @@
   value: true
   mirror: once
 
+# Edge anti-aliasing of rotated, skewed and SVG shapes. Without it they get
+# jagged edges but rasterise much faster on weak GPUs (PowerVR SGX530:
+# rotated content three times as fast). Plain page content does not use it.
+- name: gfx.webrender.edge-aa
+  type: bool
+  rust: true
+  value: true
+  mirror: once
+
 # Use vsync events generated by hardware
 - name: gfx.work-around-driver-bugs
   type: bool
-- 
