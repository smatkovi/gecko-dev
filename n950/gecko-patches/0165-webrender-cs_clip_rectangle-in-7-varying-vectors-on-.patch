From 2ea2c16678eadcd53a42dd6c111beb0ec646faba Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 16:03:01 +0100
Subject: [PATCH 165/167] webrender: cs_clip_rectangle in 7 varying vectors on
 ES 2.0

The general (non-uniform radii) clip needed 10 varying vectors. For
GLSL ES 1.00 the radii and their inverse squares go to the fragment
shader, which derives the corner centres and half-spaces from them and
the clip rectangle (vTransformBounds) with the vertex shader's formulas.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 gfx/wr/webrender/res/cs_clip_rectangle.glsl | 31 +++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/gfx/wr/webrender/res/cs_clip_rectangle.glsl b/gfx/wr/webrender/res/cs_clip_rectangle.glsl
index 818950201077..5f91bba9a623 100644
--- a/gfx/wr/webrender/res/cs_clip_rectangle.glsl
+++ b/gfx/wr/webrender/res/cs_clip_rectangle.glsl
@@ -8,6 +8,31 @@ varying highp vec4 vLocalPos;
 #ifdef WR_FEATURE_FAST_PATH
 flat varying highp vec4 v_clip_radii;
 flat varying highp vec2 v_clip_size;
+#elif __VERSION__ == 100
+// ES 2.0 GPUs may have only 8 varying vectors (PowerVR SGX530): the radii
+// and their inverse squares go to the fragment shader, which derives the
+// corner centres and half-spaces from them and the clip rectangle
+// (vTransformBounds) as the vertex shader does.
+flat varying highp vec4 v_radii_tl_tr;
+flat varying highp vec4 v_radii_br_bl;
+flat varying highp vec4 v_inv_radii_sq_tl_tr;
+flat varying highp vec4 v_inv_radii_sq_br_bl;
+#ifdef WR_VERTEX_SHADER
+vec4 vClipCenter_Radius_TL, vClipCenter_Radius_TR, vClipCenter_Radius_BL, vClipCenter_Radius_BR;
+vec3 vClipPlane_TL, vClipPlane_TR, vClipPlane_BL, vClipPlane_BR;
+#else
+vec3 wr_clip_plane(vec2 n, vec2 p) {
+    return vec3(n, dot(n, p));
+}
+#define vClipCenter_Radius_TL vec4(vTransformBounds.xy + v_radii_tl_tr.xy, v_inv_radii_sq_tl_tr.xy)
+#define vClipCenter_Radius_TR vec4(vTransformBounds.z - v_radii_tl_tr.z, vTransformBounds.y + v_radii_tl_tr.w, v_inv_radii_sq_tl_tr.zw)
+#define vClipCenter_Radius_BR vec4(vTransformBounds.zw - v_radii_br_bl.xy, v_inv_radii_sq_br_bl.xy)
+#define vClipCenter_Radius_BL vec4(vTransformBounds.x + v_radii_br_bl.z, vTransformBounds.w - v_radii_br_bl.w, v_inv_radii_sq_br_bl.zw)
+#define vClipPlane_TL wr_clip_plane(-v_radii_tl_tr.yx, vec2(vTransformBounds.x, vTransformBounds.y + v_radii_tl_tr.y))
+#define vClipPlane_TR wr_clip_plane(vec2(v_radii_tl_tr.w, -v_radii_tl_tr.z), vec2(vTransformBounds.z - v_radii_tl_tr.z, vTransformBounds.y))
+#define vClipPlane_BR wr_clip_plane(v_radii_br_bl.yx, vec2(vTransformBounds.z, vTransformBounds.w - v_radii_br_bl.y))
+#define vClipPlane_BL wr_clip_plane(vec2(-v_radii_br_bl.w, v_radii_br_bl.z), vec2(vTransformBounds.x + v_radii_br_bl.z, vTransformBounds.w))
+#endif
 #else
 flat varying highp vec4 vClipCenter_Radius_TL;
 flat varying highp vec4 vClipCenter_Radius_TR;
@@ -155,6 +180,12 @@ void main(void) {
                          dot(n_br, vec2(clip_rect.p1.x, clip_rect.p1.y - r_br.y)));
     vClipPlane_BL = vec3(n_bl,
                          dot(n_bl, vec2(clip_rect.p0.x + r_bl.x, clip_rect.p1.y)));
+#if __VERSION__ == 100
+    v_radii_tl_tr = vec4(r_tl, r_tr);
+    v_radii_br_bl = vec4(r_br, r_bl);
+    v_inv_radii_sq_tl_tr = vec4(inverse_radii_squared(r_tl), inverse_radii_squared(r_tr));
+    v_inv_radii_sq_br_bl = vec4(inverse_radii_squared(r_br), inverse_radii_squared(r_bl));
+#endif
 #endif
 }
 #endif
