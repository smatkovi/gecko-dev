From 16cbbef1fa89407fb0db7cfb045751c5276333e4 Mon Sep 17 00:00:00 2001
From: Sebastian Matkovich <sebastian.matkovich@gmail.com>
Date: Wed, 11 Nov 2026 12:25:29 +0100
Subject: [PATCH 154/156] toolkit: no unixproxy on Qt (it needs GSettings from
 widget/gtk)

Gecko 153.6 builds system/unixproxy on GTK itself, and its
nsUnixSystemProxySettings now includes widget/gtk's GSettings wrapper,
which Qt builds do not have. Without a system proxy service the
"system" proxy setting connects directly; proxies from the
preferences still work.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 toolkit/moz.build | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/toolkit/moz.build b/toolkit/moz.build
index 23bc7b82ffa8..23435785d27f 100644
--- a/toolkit/moz.build
+++ b/toolkit/moz.build
@@ -54,9 +54,7 @@ if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
         "system/commonproxy",
         "system/unixproxy",
     ]
-if CONFIG['MOZ_WIDGET_TOOLKIT'] in ('gtk', 'qt'):
-    DIRS += ["system/unixproxy"]
-elif CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
+if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
     DIRS += [
         "mozapps/dmgInstallHelper",
         "mozapps/macos-frameworks",
-- 
2.56.0

