+/// Closes a conversion `vecN(` opened before `s` at the semicolon that ends
+/// the statement; `depth` counts the parentheses still open. Returns the
+/// line and, while the statement goes on, the depth for the next line.
+fn close_conversion(s: &str, mut depth: i32) -> (String, Option<i32>) {
+    let mut out = String::new();
+    let mut closed = false;
+    for c in s.chars() {
+        if !closed {
+            match c {
+                '(' => depth += 1,
+                ')' => depth -= 1,
+                ';' if depth == 0 => {
+                    out.push(')');
+                    closed = true;
+                }
+                _ => {}
+            }
+        }
+        out.push(c);
+    }
+    (out, if closed { None } else { Some(depth) })
+}
+
+fn is_ident_char(c: char) -> bool {
+    c.is_ascii_alphanumeric() || c == '_'
+}
+
+/// The identifier at the start of `s`.
+fn leading_ident(s: &str) -> &str {
+    let end = s.find(|c: char| !is_ident_char(c)).unwrap_or(s.len());
+    &s[..end]
+}
+
+/// GLSL ES 1.00 has no texelFetch, no textureSize, no integer samplers and
+/// no token pasting. Rewrites, per line, `TEXEL_FETCH(sX, ...)` and
+/// `texelFetch(sX, ...)` into texel-centre texture2D lookups that take the
+/// texture size from a `sX_Size` uniform, `TEX_SIZE(sX)` into that uniform,
+/// and integer samplers into float ones (whose texels hold exact integers);
+/// declares `sX_Size` next to each sampler.
+pub fn rewrite_for_gles2(line: &str) -> String {
+    let trimmed = line.trim_start();
+    if trimmed.starts_with("//") {
+        return line.to_string();
+    }
+    let mut out = replace_word(line, "isampler2D", "sampler2D");
+    for (from, to) in [
+        ("texture(", "texture2D("),
+        ("mix(", "wr_mix("),
+        ("transpose(", "wr_transpose("),
+        ("inverse(", "wr_inverse("),
+        ("round(", "wr_round("),
+    ] {
+        out = replace_call(&out, from, to);
+    }
+    if trimmed.starts_with("#define") {
+        return out;
+    }
+    for (call, macro_name) in [
+        ("TEXEL_FETCH(", "WR_TEXEL_FETCH"),
+        ("texelFetch(", "WR_TEXEL_FETCH1"),
+    ] {
+        out = rewrite_calls(&out, call, |sampler, args| {
+            let suffix = if sampler.ends_with('I') { "_I" } else { "" };
+            format!("{}{}({}, {}_Size{})", macro_name, suffix, sampler, sampler, args)
+        });
+    }
+    for call in ["TEX_SIZE(", "textureSize("] {
+        out = rewrite_calls(&out, call, |sampler, _| format!("ivec2({}_Size)", sampler));
+    }
+    out = rewrite_calls(&out, "TEX_SIZE_YUV(", |sampler, _| format!("vec2({}_Size)", sampler));
+    let decl = out.trim();
+    if decl.starts_with("uniform ") && decl.contains("sampler2D") {
+        if let Some(name) = decl.strip_suffix(';').and_then(|d| d.split_whitespace().last()) {
+            out = format!("{}\nuniform highp vec2 {}_Size;", out, name);
+        }
+    } else if let Some(attr) = decl
+        .strip_prefix("PER_INSTANCE ")
+        .unwrap_or(decl)
+        .strip_prefix("attribute ")
+    {
+        let mut parts = attr.trim_end_matches(';').split_whitespace();
+        if let (Some(ty), Some(name)) = (parts.next(), parts.next()) {
+            let float_ty = match ty {
+                "int" | "uint" => Some("float"),
+                "ivec2" | "uvec2" => Some("vec2"),
+                "ivec3" | "uvec3" => Some("vec3"),
+                "ivec4" | "uvec4" => Some("vec4"),
+                _ => None,
+            };
+            if let Some(float_ty) = float_ty {
+                let int_ty = match float_ty {
+                    "float" => "int".to_string(),
+                    vec => format!("i{}", vec),
+                };
+                out = format!(
+                    "attribute {} {}_f;\n#define {} {}({}_f)",
+                    float_ty, name, name, int_ty, name
+                );
+            }
+        }
+    }
+    out
+}
+
+/// Replaces the identifier `from` by `to`.
+fn replace_word(s: &str, from: &str, to: &str) -> String {
+    let mut result = String::new();
+    let mut rest = s;
+    while let Some(pos) = rest.find(from) {
+        let before = rest[..pos].chars().last().map_or(false, is_ident_char);
+        let after = rest[pos + from.len()..].chars().next().map_or(false, is_ident_char);
+        result.push_str(&rest[..pos]);
+        result.push_str(if before || after { from } else { to });
+        rest = &rest[pos + from.len()..];
+    }
+    result.push_str(rest);
+    result
+}
+
+/// Replaces calls `from` (ending in an opening parenthesis) by `to`.
+fn replace_call(s: &str, from: &str, to: &str) -> String {
+    let mut result = String::new();
+    let mut rest = s;
+    while let Some(pos) = rest.find(from) {
+        let before = rest[..pos].chars().last().map_or(false, |c| is_ident_char(c) || c == '.');
+        result.push_str(&rest[..pos]);
+        result.push_str(if before { from } else { to });
+        rest = &rest[pos + from.len()..];
+    }
+    result.push_str(rest);
+    result
+}
+
+/// Rewrites calls `call(sampler...)` whose first argument is an identifier;
+/// `f` gets the sampler and the rest of the arguments up to the closing
+/// parenthesis (with their leading comma).
+fn rewrite_calls<F: Fn(&str, &str) -> String>(s: &str, call: &str, f: F) -> String {
+    let mut result = String::new();
+    let mut rest = s;
+    while let Some(pos) = rest.find(call) {
+        let before = rest[..pos].chars().last().map_or(false, is_ident_char);
+        result.push_str(&rest[..pos]);
+        let after = &rest[pos + call.len()..];
+        let sampler = leading_ident(after.trim_start());
+        let mut depth = 1;
+        let mut close = None;
+        for (i, c) in after.char_indices() {
+            match c {
+                '(' => depth += 1,
+                ')' => {
+                    depth -= 1;
+                    if depth == 0 {
+                        close = Some(i);
+                        break;
+                    }
+                }
+                _ => {}
+            }
+        }
+        match close {
+            Some(close) if !before && !sampler.is_empty() => {
+                let inner = after[..close].trim_start();
+                let args = &inner[sampler.len()..];
+                result.push_str(&f(sampler, args));
+                rest = &after[close + 1..];
+            }
+            _ => {
+                result.push_str(call);
+                rest = after;
+            }
+        }
+    }
+    result.push_str(rest);
+    result
 }
 
