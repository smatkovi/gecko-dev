+/// The GLSL ES 1.00 rewrite of one shader, line by line: rewrite_for_gles2,
+/// plus integer varyings, which ESSL 1 does not allow. Each becomes a highp
+/// float varying `name_f`; vertex shader assignments to it are converted,
+/// and reads round it back (`name` is defined as the rounded integer).
+struct Gles2Rewriter {
+    kind: ShaderKind,
+    int_varyings: Vec<(String, &'static str)>,
+    open_assignment: Option<i32>,
+}
+
+impl Gles2Rewriter {
+    fn new(kind: ShaderKind) -> Self {
+        Gles2Rewriter { kind, int_varyings: Vec::new(), open_assignment: None }
+    }
+
+    fn rewrite(&mut self, line: &str) -> String {
+        if line == "\n" {
+            return line.to_string();
+        }
+        if let Some(depth) = self.open_assignment {
+            let (out, state) = close_conversion(&rewrite_for_gles2(line), depth);
+            self.open_assignment = state;
+            return out;
+        }
+        let trimmed = line.trim();
+        if trimmed == "out vec4 oFragColor;" {
+            return "#define oFragColor gl_FragColor".to_string();
+        }
+        let words: Vec<&str> = trimmed.trim_end_matches(';').split_whitespace().collect();
+        if trimmed.ends_with(';') && words.contains(&"varying") {
+            let ty = words[words.len() - 2];
+            let name = words[words.len() - 1];
+            let float_ty = match ty {
+                "int" => Some("float"),
+                "ivec2" => Some("vec2"),
+                "ivec3" => Some("vec3"),
+                "ivec4" => Some("vec4"),
+                _ => None,
+            };
+            if let Some(float_ty) = float_ty {
+                self.int_varyings.push((name.to_string(), float_ty));
+                return format!(
+                    "varying highp {} {}_f;\n#define {} {}(floor({}_f + 0.5))",
+                    float_ty, name, name, ty, name
+                );
+            }
+        }
+        if self.kind == ShaderKind::Vertex {
+            if let Some(out) = self.open_assignment_to_varying(line) {
+                return out;
+            }
+        }
+        rewrite_for_gles2(line)
+    }
+
+    /// `v = ...;` or `v.xy = ...;` to an integer varying: `v_f = vecN(...);`
+    fn open_assignment_to_varying(&mut self, line: &str) -> Option<String> {
+        let trimmed = line.trim_start();
+        let indent = &line[..line.len() - trimmed.len()];
+        for (name, float_ty) in &self.int_varyings {
+            let Some(after) = trimmed.strip_prefix(name.as_str()) else { continue };
+            let (swizzle, after) = match after.strip_prefix('.') {
+                Some(rest) => {
+                    let sw = leading_ident(rest);
+                    (format!(".{}", sw), &rest[sw.len()..])
+                }
+                None => (String::new(), after),
+            };
+            if after.starts_with(|c: char| is_ident_char(c)) {
+                continue;
+            }
+            let Some(rhs) = after.trim_start().strip_prefix('=') else { continue };
+            if rhs.starts_with('=') {
+                continue;
+            }
+            let ty = match swizzle.len() {
+                0 => float_ty.to_string(),
+                2 => "float".to_string(),
+                n => format!("vec{}", n - 1),
+            };
+            let head = format!("{}{}_f{} = {}(", indent, name, swizzle, ty);
+            let (rest, state) = close_conversion(&rewrite_for_gles2(rhs.trim_start()), 0);
+            self.open_assignment = state;
+            return Some(format!("{}{}", head, rest));
+        }
+        None
+    }
+
+}
